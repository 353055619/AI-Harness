      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "e_report",
      "from": "a_archive",
      "to": "h_boss",
      "role": "main"
    },
    {
      "id": "e_fix2",
      "from": "g_arch",
      "to": "a_4a",
      "label": "打回重做",
      "variant": "dashed",
      "role": "return"
