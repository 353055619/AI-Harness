  "cards": [
    {
      "dot": "cyan",
      "title": "机器门禁",
      "items": [
        "五阶段检查共约 80 条硬规则，机械问题打回后由修订子代理自动重做，上限 10 次",
        "原始需求由人确认定稿后冻结，越界修改被 hooks 拦住；每道门都这样打回重做，图上只画一处"
      ]
    },
    {
      "dot": "rose",
      "title": "AI 评委",
      "items": [
        "四位固定架构评委（架构评审官、开发者复现官、简洁审查官、视觉验收官）加 N 个按身份卡生成的用户评委，只认证据不认说法",
        "PASS 判定线由登记表机器计算，评委本身改动也要先过回归考题"
      ]
    },
    {
      "dot": "emerald",
      "title": "回归考题",
      "items": [
        "两卷考题六颗雷：改任何门禁规则，发版前必跑考题，全逮才许发版",
        "三颗机械雷全自动验收，三颗评委雷对分核对（当前 3/3）"
      ]
    }
  ]
}